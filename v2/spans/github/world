#!/usr/bin/env python3
"""Host-side GitHub World: API authority and request policy."""
from __future__ import annotations

import base64
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import signal
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import threading
import time
from typing import Optional
import uuid


IRON = "ironsh/iron-proxy:0.49.0@sha256:c4628019c24f4cc8d77564a26b7c9cedb00accee6f93d06270e85fb8f9c6a7da"
PLACEHOLDER = "[REDACTED]"
MAX_AUTH = 1024 * 1024
MAX_CA = 1024 * 1024
MAX_CONNECT = 16 * 1024
MAX_HANDLERS = 16
MAX_BOOTSTRAP = 2 * 1024 * 1024
LENGTH = struct.Struct("!I")
ALLOWED_TARGETS = {b"api.github.com:443", b"uploads.github.com:443"}
CONNECT_LINE = re.compile(rb"CONNECT ([a-z.]+:443) HTTP/1\.[01]")
HEADER_NAME = re.compile(rb"[!#$%&'*+\-.^_`|~0-9A-Za-z]+")


class ProviderError(Exception):
    pass


def bootstrap(certificate: bytes) -> bytes:
    hosts = (
        "github.com:\n"
        "  git_protocol: ssh\n"
        "  oauth_token: " + PLACEHOLDER + "\n"
        "  user: devc2\n"
    ).encode("utf-8")
    document = {
        "v": 1,
        "ca_b64": base64.b64encode(certificate).decode("ascii"),
        "files": [{
            "name": "gh/hosts.yml",
            "contents_b64": base64.b64encode(hosts).decode("ascii"),
        }],
        "environment": {
            "GH_TOKEN": PLACEHOLDER,
            "GITHUB_TOKEN": PLACEHOLDER,
            "GH_CONFIG_DIR": "${ROOT}/gh",
            "HTTPS_PROXY": "${PROXY}",
            "https_proxy": "${PROXY}",
            "NO_PROXY": "localhost,127.0.0.1,::1,.internal",
            "no_proxy": "localhost,127.0.0.1,::1,.internal",
            "SSL_CERT_FILE": "${CA}",
            "REQUESTS_CA_BUNDLE": "${CA}",
            "CURL_CA_BUNDLE": "${CA}",
            "GIT_SSL_CAINFO": "${CA}",
            "CARGO_HTTP_CAINFO": "${CA}",
            "NODE_EXTRA_CA_CERTS": "${CA}",
        },
        "routes": ["api.github.com:443", "uploads.github.com:443"],
    }
    payload = json.dumps(document, separators=(",", ":")).encode("utf-8")
    if len(payload) > MAX_BOOTSTRAP:
        raise ProviderError("GitHub bootstrap exceeds 2 MiB")
    return payload


def auth_directory() -> Path:
    override = os.environ.get("DEVC2_GITHUB_AUTH_DIR")
    if override:
        return Path(override).expanduser()
    config = os.environ.get("XDG_CONFIG_HOME")
    root = Path(config).expanduser() if config else Path.home() / ".config"
    return root / "devc2" / "auth" / "gh"


def validate_auth(directory: Path) -> bytes:
    try:
        directory_meta = directory.lstat()
        hosts = directory / "hosts.yml"
        descriptor = os.open(hosts, os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
                             | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
    except OSError as error:
        raise ProviderError("managed GitHub auth is unavailable") from error
    try:
        metadata = os.fstat(descriptor)
        if (not stat.S_ISDIR(directory_meta.st_mode) or stat.S_ISLNK(directory_meta.st_mode)
                or directory_meta.st_uid != os.getuid() or directory_meta.st_mode & 0o022
                or not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                or metadata.st_mode & 0o022 or not 0 < metadata.st_size <= MAX_AUTH):
            raise ProviderError("managed GitHub auth is not a bounded private file")
        contents = bytearray()
        while True:
            block = os.read(descriptor, min(64 * 1024, MAX_AUTH + 1 - len(contents)))
            if not block:
                break
            contents.extend(block)
            if len(contents) > MAX_AUTH:
                raise ProviderError("managed GitHub auth is not a bounded private file")
        return bytes(contents)
    finally:
        os.close(descriptor)


def docker_environment() -> dict[str, str]:
    allowed = {"PATH", "HOME", "DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG", "XDG_RUNTIME_DIR"}
    return {key: value for key, value in os.environ.items() if key in allowed}


def docker_executable() -> str:
    found = shutil.which("docker")
    if not found:
        raise ProviderError("Docker is unavailable")
    try:
        resolved = Path(found).resolve(strict=True)
        metadata = resolved.stat()
    except OSError as error:
        raise ProviderError("Docker is unavailable") from error
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid not in (0, os.getuid())
            or metadata.st_mode & 0o022 or not os.access(resolved, os.X_OK)):
        raise ProviderError("Docker executable is unsafe")
    return os.fspath(resolved)


def run_docker(arguments: list[str], timeout: int = 60) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run([docker_executable(), *arguments], env=docker_environment(), text=True,
                              capture_output=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        raise ProviderError("Docker operation failed") from error


def read_token() -> str:
    try:
        text = validate_auth(auth_directory()).decode("utf-8")
    except UnicodeError as error:
        raise ProviderError("managed GitHub auth is unavailable or invalid") from error
    in_github = False
    tokens = []
    for line in text.splitlines():
        stripped = line.lstrip(" ")
        indentation = len(line) - len(stripped)
        if not stripped or stripped.startswith("#"):
            continue
        if indentation == 0:
            in_github = stripped == "github.com:"
            continue
        if in_github and stripped.startswith("oauth_token:"):
            tokens.append(stripped.split(":", 1)[1].strip())
    if (len(tokens) != 1 or re.fullmatch(r"[A-Za-z0-9_-]+", tokens[0]) is None
            or len(tokens[0]) > MAX_AUTH):
        raise ProviderError("managed GitHub auth is unavailable or invalid")
    return tokens[0]


def private_write(path: Path, data: bytes) -> None:
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        view = memoryview(data)
        while view:
            view = view[os.write(descriptor, view):]
    finally:
        os.close(descriptor)


def proxy_config() -> dict:
    methods = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
    rules = [{"host": host, "methods": methods, "paths": ["/", "/*"]}
             for host in ("api.github.com", "uploads.github.com")]
    return {
        "dns": {"enabled": False},
        "proxy": {"tunnel_listen": "0.0.0.0:8080", "http_listen": "127.0.0.1:0", "https_listen": "127.0.0.1:0"},
        "metrics": {"listen": "127.0.0.1:0"},
        "tls": {"mode": "mitm", "ca_cert": "/run/devc2-private/ca.crt", "ca_key": "/run/devc2-private/ca.key"},
        "transforms": [{"name": "secrets", "config": {"secrets": [{
            "source": {"type": "file", "path": "/run/devc2-private/github-token"},
            "replace": {"proxy_value": PLACEHOLDER, "match_headers": ["Authorization"], "require": True},
            "rules": rules,
        }]}}],
        "log": {"level": "warn"},
    }


def remove_container(identifier: Optional[str]) -> bool:
    if not identifier or re.fullmatch(r"[0-9a-f]{64}", identifier) is None:
        return False
    for _attempt in range(3):
        try:
            run_docker(["rm", "--force", identifier], 15)
            remaining = run_docker(["ps", "--all", "--quiet", "--no-trunc", "--filter", "id=" + identifier], 15)
        except ProviderError:
            continue
        if remaining.returncode == 0 and not remaining.stdout.split():
            return True
        time.sleep(.1)
    return False


def remove_named_container(name: str) -> bool:
    if re.fullmatch(r"devc2-github-(?:ca|proxy)-[0-9a-f]{32}", name) is None:
        return False
    for _attempt in range(3):
        try:
            run_docker(["rm", "--force", name], 15)
            remaining = run_docker(["ps", "--all", "--quiet", "--no-trunc", "--filter", "name=^/" + name + "$"], 15)
        except ProviderError:
            continue
        if remaining.returncode == 0 and not remaining.stdout.split():
            return True
        time.sleep(.1)
    return False


def cleanup_stale_roots(prefix: str) -> None:
    temporary = Path(tempfile.gettempdir()).resolve()
    for candidate in temporary.glob(prefix + "*"):
        try:
            metadata = candidate.lstat()
        except FileNotFoundError:
            continue
        if (candidate.parent.resolve() != temporary or stat.S_ISLNK(metadata.st_mode)
                or not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid()
                or metadata.st_mode & 0o077):
            raise ProviderError("stale GitHub credential directory is unsafe")
        remove_private_root(candidate)


class Proxy:
    def __init__(self, root: Path, container: str, port: int, certificate: bytes):
        self.root, self.container, self.port, self.certificate = root, container, port, certificate

    def stop(self) -> None:
        if not remove_container(self.container):
            raise ProviderError("credential proxy cleanup could not be verified")
        remove_private_root(self.root)


def remove_private_root(root: Path) -> None:
    try:
        shutil.rmtree(root)
    except OSError as error:
        raise ProviderError("GitHub credential cleanup failed") from error
    if root.exists():
        raise ProviderError("GitHub credential cleanup could not be verified")


class ProxyManager:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.proxy: Optional[Proxy] = None

    @staticmethod
    def workspace_tag() -> str:
        workspace = os.environ.get("DEVC2_WORKSPACE", "")
        if not workspace:
            raise ProviderError("GitHub Span is missing its workspace identity")
        return hashlib.sha256(os.fsencode(Path(workspace).resolve())).hexdigest()[:16]

    def _remove_stale(self, tag: str) -> None:
        found = run_docker(["ps", "--all", "--quiet", "--no-trunc", "--filter", "label=dev.devbox.github-span.workspace-hash=" + tag], 15)
        identifiers = found.stdout.split()
        if found.returncode != 0 or len(identifiers) > 8 or any(re.fullmatch(r"[0-9a-f]{64}", item) is None for item in identifiers):
            raise ProviderError("Docker could not inspect stale GitHub helpers")
        for identifier in identifiers:
            if not remove_container(identifier):
                raise ProviderError("stale GitHub helper cleanup failed")
        cleanup_stale_roots("devc2-github-" + tag + "-")

    def _running(self, proxy: Proxy) -> bool:
        result = run_docker(["inspect", "--format", "{{.State.Running}}", proxy.container], 15)
        return result.returncode == 0 and result.stdout.strip() == "true"

    def get(self) -> Proxy:
        with self.lock:
            if self.proxy is not None and self._running(self.proxy):
                return self.proxy
            if self.proxy is not None:
                raise ProviderError("GitHub credential proxy exited after its manifest was attached")
            self.proxy = self._start()
            return self.proxy

    def _start(self) -> Proxy:
        tag = self.workspace_tag()
        self._remove_stale(tag)
        root = Path(tempfile.mkdtemp(prefix="devc2-github-" + tag + "-"))
        os.chmod(root, 0o700)
        container_id = None
        proxy_name = None
        try:
            token = read_token()
            ca_name = "devc2-github-ca-" + uuid.uuid4().hex
            try:
                generated = run_docker(["run", "--pull=never", "--name", ca_name, "--rm", "--network", "none",
                    "--label", "dev.devbox.github-span.workspace-hash=" + tag,
                    "--user", f"{os.getuid()}:{os.getgid()}", "--volume", f"{root}:/out",
                    IRON, "generate-ca", "-outdir", "/out", "-alg", "ed25519", "-name", "devc2 GitHub Span"])
                if generated.returncode != 0:
                    raise ProviderError("ephemeral CA generation failed")
            finally:
                if not remove_named_container(ca_name):
                    raise ProviderError("CA helper cleanup could not be verified")
            for filename in ("ca.crt", "ca.key"):
                path = root / filename
                metadata = path.lstat()
                if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode) or metadata.st_size > MAX_CA:
                    raise ProviderError("ephemeral CA output is invalid")
                path.chmod(0o600)
            certificate = (root / "ca.crt").read_bytes()
            if (not certificate or b"-----BEGIN CERTIFICATE-----" not in certificate
                    or b"-----END CERTIFICATE-----" not in certificate or b"PRIVATE KEY" in certificate):
                raise ProviderError("ephemeral CA certificate is invalid")
            private_write(root / "github-token", token.encode())
            private_write(root / "proxy.yaml", json.dumps(proxy_config(), separators=(",", ":")).encode())
            name = "devc2-github-proxy-" + uuid.uuid4().hex
            proxy_name = name
            launched = run_docker(["run", "--pull=never", "--detach", "--rm", "--name", name,
                "--label", "dev.devbox.github-span.workspace-hash=" + tag,
                "--user", f"{os.getuid()}:{os.getgid()}", "--read-only", "--tmpfs", "/tmp:size=16m,mode=1777",
                "--memory", "128m", "--cpus", "1", "--pids-limit", "64", "--cap-drop", "ALL",
                "--security-opt", "no-new-privileges:true", "--init", "--log-driver", "none",
                "--publish", "127.0.0.1::8080", "--volume", f"{root}:/run/devc2-private:ro",
                IRON, "--config", "/run/devc2-private/proxy.yaml"])
            candidate = launched.stdout.strip()
            if launched.returncode != 0 or re.fullmatch(r"[0-9a-f]{64}", candidate) is None:
                remove_named_container(name)
                raise ProviderError("credential proxy failed to start")
            container_id = candidate
            deadline = time.monotonic() + 15
            while time.monotonic() < deadline:
                result = run_docker(["port", candidate, "8080/tcp"], 15)
                match = re.fullmatch(r"127\.0\.0\.1:(\d+)", result.stdout.strip()) if result.returncode == 0 else None
                if match and 1 <= int(match.group(1)) <= 65535:
                    port = int(match.group(1))
                    try:
                        with socket.create_connection(("127.0.0.1", port), timeout=.5):
                            return Proxy(root, candidate, port, certificate)
                    except OSError:
                        pass
                time.sleep(.05)
            raise ProviderError("credential proxy did not publish a loopback port")
        except Exception:
            removed = True
            if container_id is not None:
                removed = remove_container(container_id)
            elif proxy_name is not None:
                removed = remove_named_container(proxy_name)
            if removed:
                remove_private_root(root)
            raise

    def stop(self) -> None:
        with self.lock:
            if self.proxy is not None:
                self.proxy.stop()
                self.proxy = None


def read_connect(connection: socket.socket) -> tuple[bytes, bytes]:
    data = bytearray()
    while (marker := data.find(b"\r\n\r\n")) < 0:
        if len(data) >= MAX_CONNECT:
            raise ProviderError("CONNECT request is too large")
        block = connection.recv(min(4096, MAX_CONNECT - len(data)))
        if not block:
            raise ProviderError("CONNECT request ended early")
        data.extend(block)
    end = marker + 4
    lines = bytes(data[:marker]).split(b"\r\n")
    match = CONNECT_LINE.fullmatch(lines[0]) if lines else None
    if match is None or match.group(1) not in ALLOWED_TARGETS:
        raise ProviderError("CONNECT target or version is not allowed")
    host_count = 0
    for line in lines[1:]:
        if not line or line[:1] in (b" ", b"\t") or b":" not in line:
            raise ProviderError("CONNECT contains an invalid header")
        name, value = line.split(b":", 1)
        if HEADER_NAME.fullmatch(name) is None or any((byte < 32 and byte != 9) or byte == 127 for byte in value):
            raise ProviderError("CONNECT contains an invalid header")
        if name.lower() == b"host":
            host_count += 1
            if host_count > 1 or value.strip(b" \t") != match.group(1):
                raise ProviderError("CONNECT Host does not match its target")
    return bytes(data[:end]), bytes(data[end:])


def pump(source: socket.socket, destination: socket.socket) -> None:
    try:
        while block := source.recv(64 * 1024):
            destination.sendall(block)
    except OSError:
        pass
    try:
        destination.shutdown(socket.SHUT_WR)
    except OSError:
        pass


def handle(connection: socket.socket, manager: ProxyManager) -> None:
    with connection:
        connection.settimeout(10)
        operation = connection.recv(1)
        if operation == b"B":
            payload = bootstrap(manager.get().certificate)
            connection.sendall(LENGTH.pack(len(payload)) + payload)
            return
        if operation != b"T":
            return
        request, trailing = read_connect(connection)
        proxy = manager.get()
        with socket.create_connection(("127.0.0.1", proxy.port), timeout=10) as upstream:
            upstream.sendall(request + trailing)
            connection.settimeout(None)
            upstream.settimeout(None)
            reverse = threading.Thread(target=pump, args=(upstream, connection), daemon=True)
            reverse.start()
            pump(connection, upstream)
            reverse.join()


def serve() -> int:
    try:
        descriptor = int(os.environ["DEVC2_SPAN_SOCKET_FD"])
    except (KeyError, ValueError):
        print("github-world: missing Link listener", file=sys.stderr)
        return 2
    listener = socket.socket(fileno=descriptor)
    manager = ProxyManager()
    slots = threading.BoundedSemaphore(MAX_HANDLERS)
    stopping = threading.Event()
    def stop(_signum=None, _frame=None):
        stopping.set()
        listener.close()
    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, stop)
    try:
        while not stopping.is_set():
            try:
                connection, _address = listener.accept()
            except OSError:
                if stopping.is_set():
                    break
                raise
            if not slots.acquire(blocking=False):
                connection.close()
                continue
            def run_handler(stream: socket.socket) -> None:
                try:
                    try:
                        handle(stream, manager)
                    except (OSError, ProviderError, subprocess.SubprocessError):
                        pass
                finally:
                    slots.release()
            threading.Thread(target=run_handler, args=(connection,), daemon=True).start()
    finally:
        manager.stop()
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 1:
        print("github-world: World accepts no arguments", file=sys.stderr)
        raise SystemExit(2)
    try:
        raise SystemExit(serve())
    except (OSError, ProviderError, subprocess.SubprocessError) as error:
        print("github-world: World failed", file=sys.stderr)
        raise SystemExit(1)
