#!/usr/bin/env python3
"""Minimal public-key diagnostic for the devc2 SSH-agent Span."""
from __future__ import annotations

import base64
import os
import socket
import struct
import sys


SSH2_AGENTC_REQUEST_IDENTITIES = 11
SSH2_AGENT_IDENTITIES_ANSWER = 12
MAX_MESSAGE = 1024 * 1024
SOCKET_PATH = os.environ.get("DEVC2_SSH_AGENT_SOCKET", "/run/devc2/spans/ssh-agent.sock")


class ProtocolError(Exception):
    pass


def receive(connection: socket.socket, size: int) -> bytes:
    result = bytearray()
    while len(result) < size:
        chunk = connection.recv(size - len(result))
        if not chunk:
            raise ProtocolError("provider response ended early")
        result.extend(chunk)
    return bytes(result)


def read_string(data: bytes, offset: int) -> tuple[bytes, int]:
    if len(data) - offset < 4:
        raise ProtocolError("truncated response")
    size = struct.unpack_from(">I", data, offset)[0]
    offset += 4
    end = offset + size
    if end > len(data):
        raise ProtocolError("truncated response")
    return data[offset:end], end


def selected_key(path: str = SOCKET_PATH) -> str:
    request = bytes([SSH2_AGENTC_REQUEST_IDENTITIES])
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(10)
        connection.connect(path)
        connection.sendall(struct.pack(">I", len(request)) + request)
        size = struct.unpack(">I", receive(connection, 4))[0]
        if size < 1 or size > MAX_MESSAGE:
            raise ProtocolError("invalid provider response length")
        payload = receive(connection, size)
    if payload[0] != SSH2_AGENT_IDENTITIES_ANSWER:
        raise ProtocolError("provider refused the identities request")
    if len(payload) < 5:
        raise ProtocolError("truncated identities response")
    count = struct.unpack_from(">I", payload, 1)[0]
    if count != 1:
        raise ProtocolError(f"provider returned {count} identities instead of one")
    blob, offset = read_string(payload, 5)
    comment, offset = read_string(payload, offset)
    if offset != len(payload):
        raise ProtocolError("trailing identities data")
    algorithm, _offset = read_string(blob, 0)
    try:
        key_type = algorithm.decode("ascii", "strict")
        key_comment = comment.decode("utf-8", "replace")
    except UnicodeDecodeError as error:
        raise ProtocolError("invalid key algorithm") from error
    result = f"{key_type} {base64.b64encode(blob).decode('ascii')}"
    return f"{result} {key_comment}" if key_comment else result


def main() -> int:
    if sys.argv[1:] != ["key"]:
        print("usage: ssh-agent-span key", file=sys.stderr)
        return 2
    try:
        print(selected_key())
        return 0
    except (OSError, ProtocolError) as error:
        print(f"ssh-agent-span: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
