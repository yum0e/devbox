#!/usr/bin/env python3
"""Projected Island CLI for the deliberately narrow OpenAI Span."""
from __future__ import annotations

import base64
import json
import os
import selectors
import signal
import socket
import ssl
import struct
import subprocess
import sys
import tempfile
import threading
import urllib.parse
from pathlib import Path


DEFAULT_SOCKET = "/run/devc2/spans/openai.sock"
MAX_CA_BYTES = 1024 * 1024
MAX_SYSTEM_CA_BYTES = 16 * 1024 * 1024
MAX_HANDLERS = 16
MAX_PENDING_BYTES = 1024 * 1024
CHUNK_BYTES = 64 * 1024
HEADER = struct.Struct("!I")
FAKE_ACCOUNT = "00000000-0000-0000-0000-000000000000"
USAGE = "usage: openai run -- COMMAND [ARG...]"


class OpenAIError(RuntimeError):
    pass


def receive(connection: socket.socket, size: int) -> bytes:
    result = bytearray()
    while len(result) < size:
        chunk = connection.recv(size - len(result))
        if not chunk:
            raise OpenAIError("Span response ended early")
        result.extend(chunk)
    return bytes(result)


def receive_ca(socket_path: str) -> bytes:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(30)
        connection.connect(socket_path)
        connection.sendall(b"C")
        size = HEADER.unpack(receive(connection, HEADER.size))[0]
        if not size or size > MAX_CA_BYTES:
            raise OpenAIError("Span CA has an invalid size")
        certificate = receive(connection, size)
    try:
        text = certificate.decode("ascii")
        ssl.create_default_context(cadata=text)
    except (UnicodeDecodeError, ssl.SSLError) as error:
        raise OpenAIError("Span returned an invalid PEM CA") from error
    if "-----BEGIN CERTIFICATE-----" not in text or "-----END CERTIFICATE-----" not in text:
        raise OpenAIError("Span returned an invalid PEM CA")
    return certificate


def system_ca() -> bytes:
    paths = ssl.get_default_verify_paths()
    candidates = (paths.cafile, paths.openssl_cafile)
    for raw_path in candidates:
        if not raw_path:
            continue
        path = Path(raw_path)
        try:
            metadata = path.stat()
            if not path.is_file() or not 0 < metadata.st_size <= MAX_SYSTEM_CA_BYTES:
                continue
            data = path.read_bytes()
        except OSError:
            continue
        if b"-----BEGIN CERTIFICATE-----" in data:
            return data
    raise OpenAIError("system CA bundle is unavailable")


def jwt(claims: dict[str, object]) -> str:
    def encode(value: object) -> str:
        raw = json.dumps(value, separators=(",", ":")).encode()
        return base64.urlsafe_b64encode(raw).decode().rstrip("=")

    return f"{encode({'alg': 'none', 'typ': 'JWT'})}.{encode(claims)}.signature"


def fake_auth() -> bytes:
    access = jwt({
        "aud": ["https://api.openai.com/v1", "https://chatgpt.com/backend-api"],
        "exp": 4102444800,
        "sub": "devc2",
    })
    identity = jwt({
        "exp": 4102444800,
        "https://api.openai.com/auth": {
            "chatgpt_account_id": FAKE_ACCOUNT,
            "chatgpt_plan_type": "plus",
        },
        "sub": "devc2",
    })
    document = {
        "OPENAI_API_KEY": None,
        "auth_mode": "chatgpt",
        "tokens": {
            "id_token": identity,
            "access_token": access,
            "refresh_token": "not-a-real-refresh-token",
            "account_id": FAKE_ACCOUNT,
        },
        "last_refresh": "2025-01-01T00:00:00.000Z",
    }
    return json.dumps(document, separators=(",", ":")).encode()


def private_write(path: Path, contents: bytes) -> None:
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        view = memoryview(contents)
        while view:
            written = os.write(descriptor, view)
            view = view[written:]
    finally:
        os.close(descriptor)


class Adapter:
    def __init__(self, span_path: str, fallback_proxy: str | None = None):
        self.span_path = span_path
        self.fallback = self._fallback_address(fallback_proxy)
        self.stopping = threading.Event()
        self.slots = threading.BoundedSemaphore(MAX_HANDLERS)
        self.lock = threading.Lock()
        self.connections: set[socket.socket] = set()
        self.threads: set[threading.Thread] = set()
        self.server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.server.bind(("127.0.0.1", 0))
        self.server.listen(MAX_HANDLERS)
        self.server.settimeout(0.5)
        self.thread = threading.Thread(target=self._serve, name="openai-span-adapter", daemon=True)
        self.thread.start()

    @staticmethod
    def _fallback_address(raw: str | None) -> tuple[str, int] | None:
        if not raw:
            return None
        parsed = urllib.parse.urlsplit(raw)
        try:
            port = parsed.port
        except ValueError as error:
            raise OpenAIError("inherited proxy URL is invalid") from error
        if (parsed.scheme != "http" or not parsed.hostname or port is None
                or parsed.username is not None or parsed.password is not None
                or parsed.path not in ("", "/") or parsed.query or parsed.fragment):
            raise OpenAIError("inherited proxy URL is invalid")
        return parsed.hostname, port

    @staticmethod
    def _direct_address(first_line: bytes) -> tuple[str, int]:
        fields = first_line.split(b" ")
        if len(fields) != 3 or fields[0] != b"CONNECT" or fields[2] not in (b"HTTP/1.0", b"HTTP/1.1"):
            raise OpenAIError("unsupported proxy request")
        try:
            parsed = urllib.parse.urlsplit("//" + fields[1].decode("ascii"))
            port = parsed.port
        except (UnicodeError, ValueError) as error:
            raise OpenAIError("proxy target is invalid") from error
        if (not parsed.hostname or port != 443 or parsed.username is not None
                or parsed.password is not None or parsed.path or parsed.query or parsed.fragment):
            raise OpenAIError("proxy target is invalid")
        return parsed.hostname, port

    @property
    def url(self) -> str:
        return f"http://127.0.0.1:{self.server.getsockname()[1]}"

    def _remember(self, *connections: socket.socket) -> None:
        with self.lock:
            self.connections.update(connections)

    def _forget(self, *connections: socket.socket) -> None:
        with self.lock:
            for connection in connections:
                self.connections.discard(connection)

    def _serve(self) -> None:
        while not self.stopping.is_set():
            try:
                client, _address = self.server.accept()
            except socket.timeout:
                continue
            except OSError:
                return
            if not self.slots.acquire(blocking=False):
                client.close()
                continue
            thread = threading.Thread(target=self._handle, args=(client,), daemon=True)
            with self.lock:
                self.threads.add(thread)
            thread.start()

    def _handle(self, client: socket.socket) -> None:
        upstream = None
        initial = b""
        self._remember(client)
        client.settimeout(10)
        try:
            while b"\r\n\r\n" not in initial:
                if len(initial) >= 16 * 1024:
                    raise OpenAIError("proxy request headers exceed 16 KiB")
                chunk = client.recv(min(4096, 16 * 1024 - len(initial)))
                if not chunk:
                    raise OpenAIError("proxy request ended early")
                initial += chunk
            first_line = initial.split(b"\r\n", 1)[0]
            if first_line in (
                b"CONNECT chatgpt.com:443 HTTP/1.0",
                b"CONNECT chatgpt.com:443 HTTP/1.1",
            ):
                upstream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                upstream.settimeout(30)
                upstream.connect(self.span_path)
                upstream.sendall(b"T")
            elif self.fallback is not None:
                upstream = socket.create_connection(self.fallback, timeout=10)
            else:
                # The Island already has unrestricted egress. Preserve ordinary
                # child HTTPS without widening the credential-bearing provider.
                upstream = socket.create_connection(self._direct_address(first_line), timeout=10)
            upstream.sendall(initial)
        except (OSError, OpenAIError):
            self._forget(client)
            if upstream is not None:
                self._forget(upstream)
            client.close()
            if upstream is not None:
                upstream.close()
            self.slots.release()
            with self.lock:
                self.threads.discard(threading.current_thread())
            return
        self._remember(upstream)
        try:
            client.setblocking(False)
            upstream.setblocking(False)
            self._relay(client, upstream)
        except OSError:
            pass
        finally:
            self._forget(client, upstream)
            client.close()
            upstream.close()
            with self.lock:
                self.threads.discard(threading.current_thread())
            self.slots.release()

    def _relay(self, left: socket.socket, right: socket.socket) -> None:
        selector = selectors.DefaultSelector()
        peers = {left: right, right: left}
        pending = {left: bytearray(), right: bytearray()}
        readable = {left: True, right: True}
        write_closed = {left: False, right: False}

        def refresh(connection: socket.socket) -> None:
            if connection.fileno() < 0:
                return
            events = 0
            if readable[connection] and len(pending[peers[connection]]) < MAX_PENDING_BYTES:
                events |= selectors.EVENT_READ
            if pending[connection]:
                events |= selectors.EVENT_WRITE
            try:
                if events:
                    selector.modify(connection, events)
                else:
                    selector.unregister(connection)
            except (KeyError, ValueError):
                if events:
                    try:
                        selector.register(connection, events)
                    except (KeyError, ValueError):
                        pass

        try:
            refresh(left)
            refresh(right)
            while not self.stopping.is_set():
                if not any(readable.values()) and not any(pending.values()):
                    return
                events = selector.select(0.5)
                for key, mask in events:
                    connection = key.fileobj
                    peer = peers[connection]
                    if mask & selectors.EVENT_READ:
                        try:
                            data = connection.recv(CHUNK_BYTES)
                        except BlockingIOError:
                            data = None
                        if data:
                            pending[peer].extend(data)
                        elif data == b"":
                            readable[connection] = False
                    if mask & selectors.EVENT_WRITE and pending[connection]:
                        try:
                            sent = connection.send(pending[connection])
                        except BlockingIOError:
                            sent = 0
                        del pending[connection][:sent]
                    if not readable[peer] and not pending[connection] and not write_closed[connection]:
                        try:
                            connection.shutdown(socket.SHUT_WR)
                        except OSError:
                            pass
                        write_closed[connection] = True
                    refresh(connection)
                    refresh(peer)
        finally:
            selector.close()

    def close(self) -> None:
        self.stopping.set()
        self.server.close()
        with self.lock:
            connections = tuple(self.connections)
        for connection in connections:
            try:
                connection.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            connection.close()
        self.thread.join(timeout=2)
        with self.lock:
            threads = tuple(self.threads)
        for thread in threads:
            thread.join(timeout=2)


def child_environment(ca_path: Path, auth_path: Path, codex_home: Path, proxy: str) -> dict[str, str]:
    environment = os.environ.copy()
    environment.update({
        "HTTP_PROXY": proxy,
        "http_proxy": proxy,
        "HTTPS_PROXY": proxy,
        "https_proxy": proxy,
        "NO_PROXY": "localhost,127.0.0.1,::1,.internal",
        "no_proxy": "localhost,127.0.0.1,::1,.internal",
        "SSL_CERT_FILE": str(ca_path),
        "REQUESTS_CA_BUNDLE": str(ca_path),
        "CURL_CA_BUNDLE": str(ca_path),
        "GIT_SSL_CAINFO": str(ca_path),
        "CARGO_HTTP_CAINFO": str(ca_path),
        "NODE_EXTRA_CA_CERTS": str(ca_path),
        "TACT_AUTH": "chatgpt",
        "TACT_AUTH_FILE": str(auth_path),
        "CODEX_HOME": str(codex_home),
    })
    return environment


def run(command: list[str]) -> int:
    span_path = os.environ.get("DEVC2_OPENAI_SOCKET", DEFAULT_SOCKET)
    certificate = receive_ca(span_path)
    bundle = system_ca().rstrip(b"\n") + b"\n" + certificate.rstrip(b"\n") + b"\n"
    with tempfile.TemporaryDirectory(prefix="devc2-openai-") as raw_root:
        root = Path(raw_root)
        os.chmod(root, 0o700)
        ca_path = root / "ca.pem"
        auth_path = root / "auth.json"
        codex_home = root / "codex"
        codex_home.mkdir(mode=0o700)
        private_write(ca_path, bundle)
        auth = fake_auth()
        private_write(auth_path, auth)
        private_write(codex_home / "auth.json", auth)
        fallback = os.environ.get("HTTPS_PROXY") or os.environ.get("https_proxy")
        adapter = Adapter(span_path, fallback)
        child: subprocess.Popen[bytes] | None = None
        previous: dict[int, object] = {}
        pending_signal: int | None = None

        def forward(signum: int, _frame: object) -> None:
            nonlocal pending_signal
            if child is None:
                pending_signal = signum
            if child is not None and child.poll() is None:
                try:
                    os.killpg(child.pid, signum)
                except ProcessLookupError:
                    pass

        try:
            for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT):
                previous[signum] = signal.signal(signum, forward)
            environment = child_environment(ca_path, auth_path, codex_home, adapter.url)
            child = subprocess.Popen(command, env=environment, start_new_session=True)
            if pending_signal is not None:
                try:
                    os.killpg(child.pid, pending_signal)
                except ProcessLookupError:
                    pass
            return_code = child.wait()
        finally:
            for signum, handler in previous.items():
                signal.signal(signum, handler)
            if child is not None and child.poll() is None:
                try:
                    os.killpg(child.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                try:
                    child.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(child.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    child.wait()
            adapter.close()
    if return_code < 0:
        signum = -return_code
        signal.signal(signum, signal.SIG_DFL)
        os.kill(os.getpid(), signum)
    return return_code


def main() -> int:
    arguments = sys.argv[1:]
    if arguments in (["--help"], ["-h"], ["help"], ["run", "--help"], ["run", "-h"]):
        print(USAGE)
        return 0
    if len(arguments) < 3 or arguments[0:2] != ["run", "--"]:
        print(USAGE, file=sys.stderr)
        return 2
    try:
        return run(arguments[2:])
    except (OSError, OpenAIError, struct.error, subprocess.SubprocessError) as error:
        print(f"openai: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
