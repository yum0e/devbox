#!/usr/bin/env python3
"""Projected Island client for the reference probe Span."""
from __future__ import annotations

import os
import socket
import struct
import sys


SOCKET = os.environ.get("DEVC2_PROBE_SOCKET", "/run/devc2/spans/probe.sock")
MAX_PAYLOAD = 1024 * 1024
HEADER = struct.Struct("!cI")


def receive(connection: socket.socket, size: int) -> bytes:
    chunks = bytearray()
    while len(chunks) < size:
        chunk = connection.recv(size - len(chunks))
        if not chunk:
            raise RuntimeError("provider response ended early")
        chunks.extend(chunk)
    return bytes(chunks)


def request(operation: bytes, payload: bytes) -> bytes:
    if len(payload) > MAX_PAYLOAD:
        raise RuntimeError("payload exceeds 1 MiB")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(10)
        connection.connect(SOCKET)
        connection.sendall(HEADER.pack(operation, len(payload)) + payload)
        status, size = HEADER.unpack(receive(connection, HEADER.size))
        if size > MAX_PAYLOAD:
            raise RuntimeError("provider response exceeds 1 MiB")
        result = receive(connection, size)
    if status != b"O":
        raise RuntimeError(result.decode("utf-8", "replace"))
    return result


def main() -> int:
    try:
        if sys.argv[1:] == ["info"]:
            sys.stdout.buffer.write(request(b"I", b"") + b"\n")
        elif sys.argv[1:] == ["echo"]:
            payload = sys.stdin.buffer.read(MAX_PAYLOAD + 1)
            sys.stdout.buffer.write(request(b"E", payload))
        else:
            print("usage: probe info | probe echo < input", file=sys.stderr)
            return 2
        return 0
    except (OSError, RuntimeError, struct.error) as error:
        print(f"probe: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
