#!/usr/bin/env python3
"""Minimal host provider for exercising the experimental Span contract."""
from __future__ import annotations

import json
import os
import socket
import struct
import sys


VERSION = "0.1.0"
MAX_PAYLOAD = 1024 * 1024
HEADER = struct.Struct("!cI")


def receive(connection: socket.socket, size: int) -> bytes:
    chunks = bytearray()
    while len(chunks) < size:
        chunk = connection.recv(size - len(chunks))
        if not chunk:
            raise RuntimeError("request ended early")
        chunks.extend(chunk)
    return bytes(chunks)


def respond(connection: socket.socket, status: bytes, payload: bytes) -> None:
    connection.sendall(HEADER.pack(status, len(payload)) + payload)


def handle(connection: socket.socket) -> None:
    try:
        operation, size = HEADER.unpack(receive(connection, HEADER.size))
        if size > MAX_PAYLOAD:
            raise RuntimeError("payload exceeds 1 MiB")
        payload = receive(connection, size)
        if operation == b"I" and not payload:
            result = json.dumps(
                {
                    "span": "probe",
                    "version": VERSION,
                    "provider_pid": os.getpid(),
                    "island_id": os.environ["DEVC2_ISLAND_ID"],
                    "workspace": os.environ["DEVC2_WORKSPACE"],
                },
                sort_keys=True,
                separators=(",", ":"),
            ).encode()
        elif operation == b"E":
            result = payload
        else:
            raise RuntimeError("unknown probe operation")
        respond(connection, b"O", result)
    except (KeyError, OSError, RuntimeError, struct.error) as error:
        try:
            respond(connection, b"E", str(error).encode()[:4096])
        except OSError:
            pass


def serve() -> int:
    try:
        descriptor = int(os.environ["DEVC2_SPAN_SOCKET_FD"])
        os.environ["DEVC2_ISLAND_ID"]
        os.environ["DEVC2_WORKSPACE"]
    except (KeyError, ValueError):
        print("probe-span: missing Span runtime environment", file=sys.stderr)
        return 2
    listener = socket.socket(fileno=descriptor)
    while True:
        try:
            connection, _address = listener.accept()
        except InterruptedError:
            continue
        with connection:
            connection.settimeout(10)
            handle(connection)


def main() -> int:
    if sys.argv[1:]:
        print("probe-span: provider accepts no arguments", file=sys.stderr)
        return 2
    return serve()


if __name__ == "__main__":
    raise SystemExit(main())
