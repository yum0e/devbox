#!/usr/bin/env python3
"""Herdr World exporting one deliberately narrow command affordance."""
from __future__ import annotations

import argparse
import base64
import binascii
import contextlib
import io
import json
import os
import re
import shlex
import signal
import socket
import stat
import struct
import sys
import threading
import time
from dataclasses import dataclass, field
from pathlib import Path


MAX_REQUEST = 128 * 1024
MAX_RESPONSE = 2 * 1024 * 1024
MAX_TEXT = 64 * 1024
MAX_OUTPUT = 1024 * 1024
MAX_ARGV_BYTES = 16 * 1024
MAX_JOBS = 16
START_TIMEOUT_MS = 10_000
MAX_HANDLERS = 32
HEADER = struct.Struct("!I")
PARSE_LOCK = threading.Lock()
NAME = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")


class SpanError(RuntimeError):
    pass


class HerdrRejected(SpanError):
    def __init__(self, code: object, message: str):
        super().__init__(message)
        self.code = code


def receive(connection: socket.socket, size: int) -> bytes:
    chunks = bytearray()
    while len(chunks) < size:
        chunk = connection.recv(size - len(chunks))
        if not chunk:
            raise SpanError("stream ended early")
        chunks.extend(chunk)
    return bytes(chunks)


def send_frame(connection: socket.socket, document: dict) -> None:
    payload = json.dumps(document, separators=(",", ":")).encode()
    if len(payload) > MAX_RESPONSE:
        payload = b'{"ok":false,"error":"response exceeds 2 MiB"}'
    connection.sendall(HEADER.pack(len(payload)) + payload)


def bounded_string(value: object, label: str, maximum: int = MAX_TEXT) -> str:
    if not isinstance(value, str) or not value or len(value.encode()) > maximum or "\0" in value:
        raise SpanError(f"invalid {label}")
    return value


def bounded_input(value: object) -> str:
    text = bounded_string(value, "input")
    if any(ord(character) < 32 and character not in "\n\t" or ord(character) == 127 for character in text):
        raise SpanError("input contains terminal control characters")
    return text


def safe_socket(path: str) -> Path:
    candidate = Path(path)
    if not candidate.is_absolute():
        raise SpanError("HERDR_SOCKET_PATH must be absolute")
    metadata = candidate.lstat()
    if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != os.getuid() or metadata.st_mode & 0o022:
        raise SpanError("Herdr socket must be current-user-owned and not group/world-writable")
    return candidate


def safe_executable(raw: str) -> str:
    candidate = Path(raw)
    if not candidate.is_absolute():
        raise SpanError("worker Link executable must be absolute")
    resolved = candidate.resolve(strict=True)
    metadata = resolved.stat()
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid not in (0, os.getuid()):
        raise SpanError("unsafe worker Link executable")
    if metadata.st_mode & 0o022 or not os.access(resolved, os.X_OK):
        raise SpanError("unsafe worker Link executable")
    return str(resolved)


class Herdr:
    def __init__(self, path: Path):
        # Python 3.9 on macOS does not accept PathLike Unix-socket addresses.
        self.path = os.fspath(path)
        self.sequence = 0
        self.lock = threading.Lock()

    def call(self, method: str, params: dict, timeout: float = 10) -> dict:
        with self.lock:
            self.sequence += 1
            request_id = f"devc2-herdr-{self.sequence}"
        request = json.dumps({"id": request_id, "method": method, "params": params}, separators=(",", ":"))
        if len(request.encode()) > MAX_REQUEST:
            raise SpanError("Herdr request is too large")
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(timeout)
            connection.connect(self.path)
            connection.sendall(request.encode() + b"\n")
            stream = connection.makefile("rb")
            raw = stream.readline(MAX_RESPONSE + 1)
        if not raw or len(raw) > MAX_RESPONSE or not raw.endswith(b"\n"):
            raise SpanError("invalid response from Herdr")
        try:
            response = json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise SpanError("invalid JSON from Herdr") from error
        if not isinstance(response, dict) or response.get("id") != request_id:
            raise SpanError("mismatched response from Herdr")
        if "error" in response:
            error = response["error"]
            message = error.get("message") if isinstance(error, dict) else None
            code = error.get("code") if isinstance(error, dict) else None
            raise HerdrRejected(
                code, message if isinstance(message, str) else "Herdr rejected the request"
            )
        result = response.get("result")
        if not isinstance(result, dict):
            raise SpanError("invalid result from Herdr")
        return result


@dataclass
class Job:
    name: str
    pane_id: str
    terminal_id: str
    marker: str
    exit_code: int | None = None
    started: bool = False
    closed: bool = False
    lock: threading.RLock = field(default_factory=threading.RLock, repr=False, compare=False)


def start_marker(marker: str) -> str:
    return marker.replace("_EXIT_", "_START_", 1)


def ready_marker(marker: str) -> str:
    return marker.replace("_EXIT_", "_READY_", 1)


class World:
    def __init__(self):
        required = (
            "HERDR_SOCKET_PATH", "HERDR_PANE_ID",
            "DEVC2_HERDR_WORKER", "DEVC2_HERDR_WORKER_SOCKET",
        )
        missing = [name for name in required if not os.environ.get(name)]
        if os.environ.get("HERDR_ENV") != "1" or missing:
            raise SpanError("launch devc2 --span herdr from inside a host Herdr pane")
        self.anchor = bounded_string(os.environ["HERDR_PANE_ID"], "Herdr pane ID", 128)
        self.herdr = Herdr(safe_socket(os.environ["HERDR_SOCKET_PATH"]))
        self.worker_executable = safe_executable(os.environ["DEVC2_HERDR_WORKER"])
        self.worker_socket = safe_socket(os.environ["DEVC2_HERDR_WORKER_SOCKET"])
        self.jobs: dict[str, Job] = {}
        self.owned: dict[str, Job] = {}
        self.lock = threading.RLock()
        self.stopping = threading.Event()

    def check_anchor(self) -> None:
        result = self.herdr.call("pane.get", {"pane_id": self.anchor})
        pane = result.get("pane")
        if not isinstance(pane, dict) or pane.get("pane_id") != self.anchor:
            raise SpanError("Herdr no longer recognizes the launching pane")

    def pane(self, job: Job) -> dict:
        result = self.herdr.call("pane.get", {"pane_id": job.pane_id})
        pane = result.get("pane")
        if not isinstance(pane, dict) or pane.get("terminal_id") != job.terminal_id:
            raise SpanError(f"worker {job.name!r} no longer owns its pane")
        return pane

    def pane_output(self, job: Job) -> str:
        self.pane(job)
        result = self.herdr.call(
            "pane.read",
            {"pane_id": job.pane_id, "source": "recent_unwrapped", "lines": 1000, "strip_ansi": True},
        )
        read = result.get("read")
        if not isinstance(read, dict) or not isinstance(read.get("text"), str):
            raise SpanError("Herdr returned invalid pane output")
        return read["text"]

    def read_job(self, job: Job, lines: int = 1000) -> str:
        with job.lock:
            self.require_open(job)
            output = self.pane_output(job)
            boundary = start_marker(job.marker)
            start = output.find(boundary)
            if start >= 0:
                job.started = True
                output = output[start + len(boundary):].lstrip("\r\n")
            elif not job.started:
                # Until the worker boundary appears, the pane contains only its
                # host shell prompt and the private bootstrap invocation.
                return ""
            end = output.find(job.marker)
            if end >= 0:
                output = output[:end]
            return "".join(output.splitlines(keepends=True)[-lines:])

    def refresh(self, job: Job) -> None:
        with job.lock:
            self.require_open(job)
            if job.exit_code is not None:
                return
            output = self.pane_output(job)
            if start_marker(job.marker) in output:
                job.started = True
            match = re.search(re.escape(job.marker) + r"([0-9]{1,3})", output)
            if match:
                job.started = True
                job.exit_code = int(match.group(1))

    @staticmethod
    def require_open(job: Job) -> None:
        if job.closed:
            raise SpanError(f"worker {job.name!r} is closed")

    def forget(self, job: Job) -> None:
        job.closed = True
        with self.lock:
            if self.jobs.get(job.name) is job:
                self.jobs.pop(job.name)
            if self.owned.get(job.pane_id) is job:
                self.owned.pop(job.pane_id)

    def target_is_gone(self, job: Job) -> bool:
        try:
            result = self.herdr.call("pane.get", {"pane_id": job.pane_id})
        except HerdrRejected as error:
            return error.code == "not_found"
        except Exception:
            return False
        pane = result.get("pane")
        return isinstance(pane, dict) and pane.get("terminal_id") != job.terminal_id

    def get_job(self, name: object) -> Job:
        if not isinstance(name, str) or not NAME.fullmatch(name):
            raise SpanError("invalid worker name")
        with self.lock:
            job = self.jobs.get(name)
        if job is None:
            raise SpanError(f"unknown worker: {name}")
        return job

    def spawn(self, request: dict) -> str:
        if set(request) != {"op", "name", "argv"}:
            raise SpanError("spawn accepts only name and argv")
        name = request["name"]
        argv = request["argv"]
        if not isinstance(name, str) or not NAME.fullmatch(name):
            raise SpanError("worker name must match [a-z][a-z0-9_-]{0,31}")
        if not isinstance(argv, list) or not argv or len(argv) > 64:
            raise SpanError("spawn requires 1 to 64 argv values")
        if not all(isinstance(item, str) and "\0" not in item for item in argv):
            raise SpanError("invalid worker argv")
        if sum(len(item.encode()) for item in argv) > MAX_ARGV_BYTES:
            raise SpanError("worker argv exceeds 16 KiB")
        with self.lock:
            if self.stopping.is_set():
                raise SpanError("Herdr Span is stopping")
            if name in self.jobs:
                raise SpanError(f"worker already exists: {name}")
            if len(self.owned) >= MAX_JOBS:
                raise SpanError(f"an Island may create at most {MAX_JOBS} Herdr workers")
            split = self.herdr.call(
                "pane.split",
                {"target_pane_id": self.anchor, "direction": "right", "focus": False},
            )
            pane = split.get("pane")
            if not isinstance(pane, dict) or not isinstance(pane.get("pane_id"), str) or not isinstance(pane.get("terminal_id"), str):
                raise SpanError("Herdr returned an invalid new pane")
            marker = f"__DEVC2_HERDR_{os.urandom(16).hex()}_EXIT_"
            job = Job(name, pane["pane_id"], pane["terminal_id"], marker)
            self.owned[job.pane_id] = job
            payload = base64.urlsafe_b64encode(
                json.dumps({
                    "socket": os.fspath(self.worker_socket), "argv": argv, "marker": marker,
                }, separators=(",", ":")).encode()
            ).decode()
            try:
                command = (
                    "exec /usr/bin/env -i "
                    "PATH=/usr/local/bin:/usr/bin:/bin "
                    f"{shlex.quote(self.worker_executable)} worker {payload}"
                )
                self.herdr.call(
                    "pane.send_input", {"pane_id": job.pane_id, "text": command, "keys": ["Enter"]}
                )
                self.herdr.call("pane.rename", {"pane_id": job.pane_id, "label": name})
                ready = self.herdr.call(
                    "pane.wait_for_output",
                    {
                        "pane_id": job.pane_id,
                        "source": "recent_unwrapped",
                        "lines": 1000,
                        "match": {"type": "substring", "value": start_marker(job.marker)},
                        "timeout_ms": START_TIMEOUT_MS,
                    },
                    timeout=START_TIMEOUT_MS / 1000 + 5,
                )
                if ready.get("type") != "output_matched":
                    raise SpanError("worker start marker was not found")
                self.herdr.call(
                    "pane.send_input",
                    {"pane_id": job.pane_id, "text": ready_marker(job.marker), "keys": ["Enter"]},
                )
                job.started = True
                self.jobs[name] = job
            except Exception:
                try:
                    self.herdr.call("pane.close", {"pane_id": job.pane_id})
                except Exception:
                    pass
                else:
                    self.owned.pop(job.pane_id, None)
                raise
        return name

    def handle(self, request: dict) -> object:
        if not isinstance(request, dict) or not isinstance(request.get("op"), str):
            raise SpanError("request must contain an operation")
        # Upstream health is a command-call concern, not World startup readiness.
        # Retrying every call also lets a restarted Herdr server recover naturally.
        self.check_anchor()
        operation = request["op"]
        if operation == "spawn":
            return self.spawn(request)
        if operation == "list":
            if set(request) != {"op"}:
                raise SpanError("list accepts no arguments")
            with self.lock:
                jobs = list(self.jobs.values())
            result = []
            for job in jobs:
                try:
                    self.refresh(job)
                    state = "running" if job.exit_code is None else f"exited:{job.exit_code}"
                except SpanError:
                    state = "gone"
                result.append({"name": job.name, "state": state})
            return result
        if operation == "read":
            if set(request) != {"op", "name", "lines"} or not isinstance(request["lines"], int) or not 1 <= request["lines"] <= 1000:
                raise SpanError("read requires 1 to 1000 lines")
            return self.read_job(self.get_job(request["name"]), request["lines"])
        if operation == "send":
            if set(request) != {"op", "name", "text"}:
                raise SpanError("send accepts only name and text")
            text = bounded_input(request["text"])
            job = self.get_job(request["name"])
            with job.lock:
                self.require_open(job)
                self.refresh(job)
                if job.exit_code is not None:
                    raise SpanError(f"worker {job.name!r} has exited")
                self.herdr.call("pane.send_input", {"pane_id": job.pane_id, "text": text, "keys": ["Enter"]})
            return None
        if operation == "close":
            if set(request) != {"op", "name"}:
                raise SpanError("close accepts only name")
            job = self.get_job(request["name"])
            with job.lock:
                self.require_open(job)
                try:
                    self.pane(job)
                    self.herdr.call("pane.close", {"pane_id": job.pane_id})
                except Exception as error:
                    if self.target_is_gone(job):
                        self.forget(job)
                        return None
                    raise error
                self.forget(job)
            return None
        if operation == "wait":
            if set(request) != {"op", "name", "timeout_ms"}:
                raise SpanError("wait accepts only name and timeout_ms")
            timeout_ms = request["timeout_ms"]
            if not isinstance(timeout_ms, int) or not 1 <= timeout_ms <= 3_600_000:
                raise SpanError("wait timeout must be between 1 ms and 1 hour")
            job = self.get_job(request["name"])
            deadline = time.monotonic() + timeout_ms / 1000
            while True:
                with job.lock:
                    self.require_open(job)
                    self.refresh(job)
                    if job.exit_code is not None:
                        return {"exit_code": job.exit_code}
                    remaining_ms = int((deadline - time.monotonic()) * 1000)
                    if remaining_ms <= 0:
                        break
                    interval_ms = min(remaining_ms, 500)
                    self.herdr.call(
                        "pane.wait_for_output",
                        {
                            "pane_id": job.pane_id,
                            "source": "recent_unwrapped",
                            "lines": 1000,
                            "match": {"type": "substring", "value": job.marker},
                            "timeout_ms": interval_ms,
                        },
                        timeout=interval_ms / 1000 + 5,
                    )
                # Give close a deterministic opportunity between bounded waits.
                time.sleep(0)
            raise SpanError("worker completion marker was not found")
        raise SpanError("unknown operation")

    def cleanup(self) -> None:
        self.stopping.set()
        with self.lock:
            jobs = list(self.owned.values())

        def close(job: Job) -> None:
            with job.lock:
                if job.closed:
                    return
                for _attempt in range(2):
                    try:
                        result = self.herdr.call("pane.get", {"pane_id": job.pane_id}, timeout=0.5)
                        pane = result.get("pane")
                        if not isinstance(pane, dict):
                            continue
                        if pane.get("terminal_id") != job.terminal_id:
                            self.forget(job)
                            return
                        self.herdr.call("pane.close", {"pane_id": job.pane_id}, timeout=0.5)
                    except HerdrRejected as error:
                        if error.code == "not_found":
                            self.forget(job)
                            return
                    except Exception:
                        if self.target_is_gone(job):
                            self.forget(job)
                            return
                    continue
                    self.forget(job)
                    return

        threads = [threading.Thread(target=close, args=(job,)) for job in jobs]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join(timeout=2)


def command_parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(
        prog="herdr",
        description="Run and control host-visible workers inside this Island.",
    )
    commands = root.add_subparsers(dest="command", required=True)
    spawn = commands.add_parser("spawn", help="create a Herdr pane running Island argv")
    spawn.add_argument("name")
    spawn.add_argument("argv", nargs=argparse.REMAINDER)
    commands.add_parser("list", help="list workers created by this Island")
    read = commands.add_parser("read", help="read recent worker output")
    read.add_argument("name")
    read.add_argument("--lines", type=int, default=200)
    send = commands.add_parser("send", help="submit stdin and Enter to a running worker")
    send.add_argument("name")
    close = commands.add_parser("close", help="close a worker pane owned by this Island")
    close.add_argument("name")
    wait = commands.add_parser("wait", help="wait for a worker to exit")
    wait.add_argument("name")
    wait.add_argument("--timeout", type=float, default=300, metavar="SECONDS")
    return root


def invoke_command(world: World, request: object) -> dict:
    if not isinstance(request, dict) or set(request) != {"v", "command", "argv", "stdin_b64"}:
        raise SpanError("invalid command invocation")
    if request["v"] != 1 or request["command"] != "herdr":
        raise SpanError("command is not exported by this World")
    argv = request["argv"]
    if not isinstance(argv, list) or len(argv) > 64 or not all(isinstance(item, str) and "\0" not in item for item in argv):
        raise SpanError("invalid command argv")
    if sum(len(item.encode()) for item in argv) > MAX_ARGV_BYTES:
        raise SpanError("command argv exceeds 16 KiB")
    encoded = request["stdin_b64"]
    if not isinstance(encoded, str):
        raise SpanError("invalid command input")
    try:
        raw_input = base64.b64decode(encoded, validate=True)
    except (ValueError, binascii.Error) as error:
        raise SpanError("invalid command input") from error
    if len(raw_input) > MAX_TEXT:
        raise SpanError("command input exceeds 64 KiB")

    stdout, stderr = io.StringIO(), io.StringIO()
    exit_code = 0
    args = None
    try:
        # argparse writes through process-global stdout/stderr. Keep only that
        # short, local parsing step serialized; World operations stay concurrent.
        with PARSE_LOCK, contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
            try:
                args = command_parser().parse_args(argv)
            except SystemExit as error:
                exit_code = error.code if isinstance(error.code, int) else 2
        if args is not None:
            if args.command != "send" and raw_input:
                raise SpanError("only herdr send accepts stdin")
            if args.command == "spawn":
                command = args.argv[1:] if args.argv[:1] == ["--"] else args.argv
                if not command:
                    raise SpanError("spawn requires COMMAND [ARG...] after --")
                stdout.write(f"{world.handle({'op': 'spawn', 'name': args.name, 'argv': command})}\n")
            elif args.command == "list":
                result = world.handle({"op": "list"})
                if not isinstance(result, list):
                    raise SpanError("invalid Herdr result")
                for item in result:
                    if not isinstance(item, dict) or not isinstance(item.get("name"), str) or not isinstance(item.get("state"), str):
                        raise SpanError("invalid Herdr result")
                    stdout.write(f"{item['name']}\t{item['state']}\n")
            elif args.command == "read":
                result = world.handle({"op": "read", "name": args.name, "lines": args.lines})
                if not isinstance(result, str):
                    raise SpanError("invalid Herdr result")
                stdout.write(result)
                if result and not result.endswith("\n"):
                    stdout.write("\n")
            elif args.command == "send":
                text = raw_input.decode()
                world.handle({"op": "send", "name": args.name, "text": text})
            elif args.command == "close":
                world.handle({"op": "close", "name": args.name})
            elif args.command == "wait":
                if not 0 < args.timeout <= 3600:
                    raise SpanError("timeout must be between 0 and 3600 seconds")
                result = world.handle({"op": "wait", "name": args.name, "timeout_ms": max(1, int(args.timeout * 1000))})
                if not isinstance(result, dict) or not isinstance(result.get("exit_code"), int):
                    raise SpanError("invalid Herdr result")
                exit_code = result["exit_code"]
    except (SpanError, UnicodeDecodeError) as error:
        stderr.write(f"herdr: {error}\n")
        exit_code = 1

    stdout_bytes, stderr_bytes = stdout.getvalue().encode(), stderr.getvalue().encode()
    if len(stdout_bytes) + len(stderr_bytes) > MAX_OUTPUT:
        raise SpanError("command output exceeds 1 MiB")
    if not 0 <= exit_code <= 255:
        exit_code = 255
    return {
        "ok": True,
        "stdout_b64": base64.b64encode(stdout_bytes).decode("ascii"),
        "stderr_b64": base64.b64encode(stderr_bytes).decode("ascii"),
        "exit_code": exit_code,
    }


def serve() -> int:
    try:
        descriptor = int(os.environ["DEVC2_SPAN_SOCKET_FD"])
    except (KeyError, ValueError):
        print("herdr-span: missing Span listener", file=sys.stderr)
        return 2
    world = World()
    listener = socket.socket(fileno=descriptor)
    handlers = threading.BoundedSemaphore(MAX_HANDLERS)

    def stop(_signum, _frame):
        raise SystemExit(0)

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, stop)
    try:
        while True:
            connection, _address = listener.accept()
            if not handlers.acquire(blocking=False):
                with connection:
                    try:
                        send_frame(connection, {"ok": False, "error": "too many concurrent Herdr requests"})
                    except OSError:
                        pass
                continue

            def handle(stream: socket.socket) -> None:
                try:
                    with stream:
                        stream.settimeout(10)
                        try:
                            size = HEADER.unpack(receive(stream, HEADER.size))[0]
                            if size > MAX_REQUEST:
                                raise SpanError("request exceeds 128 KiB")
                            request = json.loads(receive(stream, size))
                            send_frame(stream, invoke_command(world, request))
                        except (OSError, SpanError, UnicodeDecodeError, json.JSONDecodeError, struct.error) as error:
                            try:
                                send_frame(stream, {"ok": False, "error": str(error)[:4096]})
                            except OSError:
                                pass
                finally:
                    handlers.release()

            threading.Thread(target=handle, args=(connection,), daemon=True).start()
    finally:
        world.cleanup()


def main() -> int:
    if sys.argv[1:]:
        print("herdr-span: World accepts no devc2 arguments", file=sys.stderr)
        return 2
    return serve()


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, SpanError) as error:
        print(f"herdr-span: {error}", file=sys.stderr)
        raise SystemExit(1)
