IRON = "ironsh/iron-proxy:0.49.0@sha256:c4628019c24f4cc8d77564a26b7c9cedb00accee6f93d06270e85fb8f9c6a7da"
MAX_AUTH = 1024 * 1024
MAX_CA = 1024 * 1024
MAX_CONNECT = 16 * 1024
MAX_HANDLERS = 256
MAX_BOOTSTRAP = 2 * 1024 * 1024
RECOVERY_COOLDOWN = 5.0
LENGTH = struct.Struct("!I")
CONNECT_LINE = re.compile(rb"CONNECT ([a-z.]+:443) HTTP/1\.[01]")
HEADER_NAME = re.compile(rb"[!#$%&'*+\-.^_`|~0-9A-Za-z]+")


class Policy(NamedTuple):
    name: str
    targets: tuple[bytes, ...]
    routes: tuple[str, ...]


POLICIES = {
    "openai": Policy("openai", (b"chatgpt.com:443",), ("chatgpt.com:443",)),
    "github": Policy("github", (b"api.github.com:443", b"uploads.github.com:443"),
                     ("api.github.com:443", "uploads.github.com:443")),
}
DEFAULT_POLICY = POLICIES["openai"]  # Unit helpers must opt into GitHub explicitly.


def select_policy(executable: str) -> Policy:
    try:
        return POLICIES[Path(executable).name]
    except KeyError as error:
        raise WorldError("World executable basename must be exactly openai or github") from error


class WorldError(Exception):
    pass


class CleanupError(WorldError):
    pass


def recovery_event(event: bytes) -> None:
    raw = os.environ.get("DEVC2_RECOVERY_FD")
    if event not in {b"S", b"R", b"F"} or raw is None:
        return
    try:
        os.write(int(raw), event)
    except (OSError, ValueError):
        pass


def jwt(claims: dict) -> str:
    def encode(value: dict) -> str:
        return base64.urlsafe_b64encode(
            json.dumps(value, separators=(",", ":")).encode("ascii")
        ).decode("ascii").rstrip("=")

    return "%s.%s.signature" % (
        encode({"alg": "none", "typ": "JWT"}),
        encode(claims),
    )


def fake_identity() -> tuple[str, str, bytes]:
    account = str(uuid.uuid4())
    subject = secrets.token_urlsafe(32)
    access = jwt({
        "aud": ["https://api.openai.com/v1", "https://chatgpt.com/backend-api"],
        "exp": 4102444800,
        "https://api.openai.com/auth": {
            "chatgpt_account_id": account,
            "chatgpt_plan_type": "plus",
        },
        "sub": subject,
    })
    identity = jwt({
        "exp": 4102444800,
        "https://api.openai.com/auth": {
            "chatgpt_account_id": account,
            "chatgpt_plan_type": "plus",
        },
        "sub": subject,
    })
    document = {
        "OPENAI_API_KEY": None,
        "auth_mode": "chatgpt",
        "tokens": {
            "id_token": identity,
            "access_token": access,
            "refresh_token": secrets.token_urlsafe(32),
            "account_id": account,
        },
        "last_refresh": "2025-01-01T00:00:00.000Z",
    }
    return account, access, json.dumps(document, separators=(",", ":")).encode()


def bootstrap(policy: Policy, certificate: bytes, fake: tuple[str, str, bytes]) -> bytes:
    account, sentinel, auth_document = fake
    common_environment = {
        "HTTPS_PROXY": "${PROXY}", "https_proxy": "${PROXY}",
        "NO_PROXY": "localhost,127.0.0.1,::1,.internal",
        "no_proxy": "localhost,127.0.0.1,::1,.internal",
        "SSL_CERT_FILE": "${CA}", "REQUESTS_CA_BUNDLE": "${CA}",
        "CURL_CA_BUNDLE": "${CA}", "GIT_SSL_CAINFO": "${CA}",
        "CARGO_HTTP_CAINFO": "${CA}", "NODE_EXTRA_CA_CERTS": "${CA}",
    }
    if policy.name == "openai":
        encoded = base64.b64encode(auth_document).decode("ascii")
        files = [{"name": "auth.json", "contents_b64": encoded},
                 {"name": "codex/auth.json", "contents_b64": encoded}]
        environment = {**common_environment, "TACT_AUTH": "chatgpt",
            "TACT_AUTH_FILE": "${ROOT}/auth.json", "CODEX_HOME": "${ROOT}/codex",
            "DEVC2_PI_OPENAI_TOKEN": sentinel}
    else:
        hosts = ("github.com:\n  git_protocol: ssh\n  oauth_token: " + sentinel
                 + "\n  user: devc2\n").encode()
        files = [{"name": "gh/hosts.yml",
                  "contents_b64": base64.b64encode(hosts).decode("ascii")}]
        environment = {**common_environment, "GH_TOKEN": sentinel,
                       "GITHUB_TOKEN": sentinel, "GH_CONFIG_DIR": "${ROOT}/gh"}
    document = {
        "v": 1,
        "ca_b64": base64.b64encode(certificate).decode("ascii"),
        "files": files, "environment": environment, "routes": list(policy.routes),
    }
    payload = json.dumps(document, separators=(",", ":")).encode()
    if len(payload) > MAX_BOOTSTRAP:
        raise WorldError(policy.name + " bootstrap exceeds 2 MiB")
    return payload


def auth_path() -> Path:
    override = os.environ.get("DEVC2_OPENAI_AUTH_FILE")
    if override:
        return Path(override).expanduser()
    config = os.environ.get("XDG_CONFIG_HOME")
    root = Path(config).expanduser() if config else Path.home() / ".config"
    return root / "devc2" / "auth" / "codex" / "auth.json"


def read_auth() -> tuple[str, str]:
    path = auth_path()
    descriptor = -1
    try:
        flags = (os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
                 | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
        descriptor = os.open(str(path), flags)
        metadata = os.fstat(descriptor)
        if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                or metadata.st_mode & 0o022 or metadata.st_size > MAX_AUTH):
            raise WorldError("managed ChatGPT auth is not a bounded regular file")
        contents = bytearray()
        while len(contents) <= MAX_AUTH:
            block = os.read(descriptor, min(64 * 1024, MAX_AUTH + 1 - len(contents)))
            if not block:
                break
            contents.extend(block)
        if len(contents) > MAX_AUTH:
            raise WorldError("managed ChatGPT auth is not a bounded regular file")
        document = json.loads(bytes(contents).decode("utf-8"))
    except WorldError:
        raise
    except (OSError, UnicodeError, ValueError, TypeError) as error:
        raise WorldError("managed ChatGPT auth is unavailable or invalid") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)

    if not isinstance(document, dict):
        raise WorldError("managed ChatGPT auth is invalid")
    tokens = document.get("tokens", document)
    if not isinstance(tokens, dict):
        raise WorldError("managed ChatGPT auth is invalid")
    access = tokens.get("access_token")
    account = tokens.get("account_id")
    if (not isinstance(access, str) or not access or len(access) > MAX_AUTH
            or any(character.isspace() or character == "\0" for character in access)
            or not isinstance(account, str) or not account or len(account) > 4096
            or any(character.isspace() or character == "\0" for character in account)):
        raise WorldError("managed ChatGPT auth lacks required credentials")
    try:
        fields = access.split(".")
        if len(fields) != 3 or not fields[1]:
            raise ValueError
        payload = fields[1] + "=" * (-len(fields[1]) % 4)
        claims = json.loads(base64.urlsafe_b64decode(payload.encode("ascii")))
        expiry = claims["exp"]
        if isinstance(expiry, bool) or not isinstance(expiry, (int, float)):
            raise ValueError
    except (KeyError, TypeError, ValueError, UnicodeError, json.JSONDecodeError) as error:
        raise WorldError("managed ChatGPT access token is malformed") from error
    if not math.isfinite(expiry) or expiry < time.time() + 3600:
        raise WorldError("managed ChatGPT access token expires within one hour")
    return access, account


def auth_directory() -> Path:
    override = os.environ.get("DEVC2_GITHUB_AUTH_DIR")
    if override:
        return Path(override).expanduser()
    config = os.environ.get("XDG_CONFIG_HOME")
    root = Path(config).expanduser() if config else Path.home() / ".config"
    return root / "devc2" / "auth" / "gh"


def read_github_auth() -> tuple[str, str]:
    directory = auth_directory()
    descriptor = -1
    try:
        directory_meta = directory.lstat()
        descriptor = os.open(directory / "hosts.yml", os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
                             | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NONBLOCK", 0))
        metadata = os.fstat(descriptor)
        if (not stat.S_ISDIR(directory_meta.st_mode) or stat.S_ISLNK(directory_meta.st_mode)
                or directory_meta.st_uid != os.getuid() or directory_meta.st_mode & 0o022
                or not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
                or metadata.st_mode & 0o022 or not 0 < metadata.st_size <= MAX_AUTH):
            raise WorldError("managed GitHub auth is not a bounded private file")
        contents = bytearray()
        while len(contents) <= MAX_AUTH:
            block = os.read(descriptor, min(64 * 1024, MAX_AUTH + 1 - len(contents)))
            if not block:
                break
            contents.extend(block)
        if len(contents) > MAX_AUTH:
            raise WorldError("managed GitHub auth is not a bounded private file")
    except WorldError:
        raise
    except OSError as error:
        raise WorldError("managed GitHub auth is unavailable") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    try:
        text = bytes(contents).decode("utf-8")
    except UnicodeError as error:
        raise WorldError("managed GitHub auth is unavailable or invalid") from error
    in_github, tokens = False, []
    for line in text.splitlines():
        stripped = line.lstrip(" ")
        if not stripped or stripped.startswith("#"):
            continue
        if len(line) == len(stripped):
            in_github = stripped == "github.com:"
        elif in_github and stripped.startswith("oauth_token:"):
            tokens.append(stripped.split(":", 1)[1].strip())
    if (len(tokens) != 1 or re.fullmatch(r"[A-Za-z0-9_-]+", tokens[0]) is None
            or len(tokens[0]) > MAX_AUTH):
        raise WorldError("managed GitHub auth is unavailable or invalid")
    return tokens[0], ""


def private_write(path: Path, data: bytes) -> None:
    descriptor = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        view = memoryview(data)
        while view:
            written = os.write(descriptor, view)
            view = view[written:]
    finally:
        os.close(descriptor)


def private_replace(path: Path, data: bytes) -> None:
    temporary = path.with_name(path.name + ".new-" + uuid.uuid4().hex)
    try:
        private_write(temporary, data)
        os.replace(str(temporary), str(path))
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def docker_environment() -> dict[str, str]:
    allowed = {
        "PATH", "HOME", "DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG",
        "XDG_RUNTIME_DIR",
    }
    return {key: value for key, value in os.environ.items() if key in allowed}


def docker_executable() -> str:
    found = shutil.which("docker")
    if not found:
        raise WorldError("Docker is unavailable")
    try:
        resolved = Path(found).resolve(strict=True)
        metadata = resolved.stat()
    except OSError as error:
        raise WorldError("Docker is unavailable") from error
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid not in (0, os.getuid())
            or metadata.st_mode & 0o022 or not os.access(resolved, os.X_OK)):
        raise WorldError("Docker executable is unsafe")
    return os.fspath(resolved)


def run_docker(
    arguments: list[str],
    timeout: float = 120,
    stopping: Optional[threading.Event] = None,
) -> subprocess.CompletedProcess:
    process = None
    try:
        process = subprocess.Popen(
            [docker_executable()] + arguments,
            env=docker_environment(),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        deadline = time.monotonic() + timeout
        while True:
            if stopping is not None and stopping.is_set():
                raise WorldError("Docker operation stopped")
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(process.args, timeout)
            try:
                stdout, stderr = process.communicate(timeout=min(0.1, remaining))
                return subprocess.CompletedProcess(
                    process.args, process.returncode, stdout, stderr,
                )
            except subprocess.TimeoutExpired:
                continue
    except (OSError, subprocess.SubprocessError) as error:
        raise WorldError("Docker operation failed") from error
    finally:
        if process is not None and process.poll() is None:
            process.terminate()
            try:
                process.communicate(timeout=1)
            except subprocess.TimeoutExpired:
                process.kill()
                process.communicate()


def remove_container(identifier: Optional[str]) -> bool:
    if not identifier or re.fullmatch(r"[0-9a-f]{64}", identifier) is None:
        return False
    for _attempt in range(3):
        try:
            run_docker(["rm", "--force", identifier], 15)
            remaining = run_docker([
                "ps", "--all", "--quiet", "--no-trunc", "--filter", "id=" + identifier,
            ], 15)
        except WorldError:
            continue
        if remaining.returncode == 0 and not remaining.stdout.split():
            return True
        time.sleep(0.1)
    return False


def remove_named_container(name: str) -> bool:
    if re.fullmatch(r"devc2-(?:openai|github)-(?:ca|proxy)-[0-9a-f]{32}", name) is None:
        return False
    for _attempt in range(3):
        try:
            run_docker(["rm", "--force", name], 15)
            remaining = run_docker([
                "ps", "--all", "--quiet", "--no-trunc", "--filter", "name=^/" + name + "$",
            ], 15)
        except WorldError:
            continue
        if remaining.returncode == 0 and not remaining.stdout.split():
            return True
        time.sleep(0.1)
    return False


def cleanup_stale_roots(prefix: str) -> None:
    temporary = Path(tempfile.gettempdir()).resolve()
    for candidate in temporary.glob(prefix + "*"):
        try:
            metadata = candidate.lstat()
        except FileNotFoundError:
            continue
        if (candidate.parent.resolve() != temporary or stat.S_ISLNK(metadata.st_mode)
                or not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid()
                or metadata.st_mode & 0o077):
            raise WorldError("stale credential directory is unsafe")
        shutil.rmtree(candidate)


def proxy_config(policy: Policy, fake_access: str, fake_account: str = "") -> dict:
    def secret(filename: str, placeholder: str, header: str) -> dict:
        if policy.name == "openai":
            rules = [{"host": "chatgpt.com", "methods": ["GET", "POST"],
                      "paths": ["/backend-api/codex", "/backend-api/codex/*"]}]
        else:
            methods = ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"]
            rules = [{"host": host, "methods": methods, "paths": ["/", "/*"]}
                     for host in ("api.github.com", "uploads.github.com")]
        return {
            "source": {"type": "file", "path": "/run/devc2-private/" + filename},
            "replace": {
                "proxy_value": placeholder,
                "match_headers": [header],
                "require": True,
            },
            "rules": rules,
        }

    secrets_config = ([secret("access-token", fake_access, "Authorization"),
                       secret("account-id", fake_account, "chatgpt-account-id")]
                      if policy.name == "openai" else
                      [secret("github-token", fake_access, "Authorization")])

    return {
        "dns": {"enabled": False},
        "proxy": {
            # Docker publishes this listener on host loopback only; the
            # container-side listener must be reachable through the gateway sidecar NIC.
            "tunnel_listen": "0.0.0.0:8080",
            "http_listen": "127.0.0.1:0",
            "https_listen": "127.0.0.1:0",
        },
        "metrics": {"listen": "127.0.0.1:0"},
        "tls": {
            "mode": "mitm",
            "ca_cert": "/run/devc2-private/ca.crt",
            "ca_key": "/run/devc2-private/ca.key",
        },
        "transforms": [{
            "name": "secrets",
            "config": {"secrets": secrets_config},
        }],
        "log": {"level": "warn"},
    }


class Proxy:
    def __init__(self, root: Path, container: str, port: int, certificate: bytes):
        self.root = root
        self.container = container
        self.port = port
        self.certificate = certificate

    def stop(self) -> None:
        if not remove_container(self.container):
            raise WorldError("credential proxy cleanup could not be verified")
        remove_private_root(self.root)


def remove_private_root(root: Path) -> None:
    try:
        shutil.rmtree(str(root))
    except OSError as error:
        raise WorldError("credential cleanup failed") from error
    if root.exists():
        raise WorldError("credential cleanup could not be verified")


class ProxyManager:
    def __init__(self, policy: Optional[Policy] = None) -> None:
        self.policy = policy or DEFAULT_POLICY
        self.lock = threading.Lock()
        self.proxy: Optional[Proxy] = None
        self.fake = (fake_identity() if self.policy.name == "openai"
                     else ("", secrets.token_urlsafe(32), b""))
        self.fake_account, self.fake_access, self.fake_auth = self.fake
        self.sentinel = self.fake_access
        self._manifest: Optional[bytes] = None
        self.stopping = threading.Event()
        self.recovery_not_before = 0.0

    def workspace_tag(self) -> str:
        raw = os.environ.get("DEVC2_WORKSPACE", "")
        if not raw:
            raise WorldError(self.policy.name + " Span is missing its workspace identity")
        return hashlib.sha256(os.fsencode(Path(raw).resolve())).hexdigest()[:16]

    def _remove_stale(self, tag: str) -> None:
        found = run_docker([
            "ps", "--all", "--quiet", "--no-trunc", "--filter",
            "label=dev.devbox." + self.policy.name + "-span.workspace-hash=" + tag,
        ], 15)
        if found.returncode != 0:
            raise WorldError("Docker could not inspect stale credential proxies")
        identifiers = found.stdout.split()
        if len(identifiers) > 8 or any(re.fullmatch(r"[0-9a-f]{64}", item) is None for item in identifiers):
            raise WorldError("Docker returned invalid stale helper identities")
        for identifier in identifiers:
            if not remove_container(identifier):
                raise WorldError("stale credential proxy cleanup failed")
        cleanup_stale_roots("devc2-" + self.policy.name + "-" + tag + "-")

    def _state(self, proxy: Proxy) -> str:
        result = run_docker(["inspect", "--format", "{{.State.Running}}", proxy.container], 15)
        if result.returncode == 0 and result.stdout.strip() in ("true", "false"):
            return "running" if result.stdout.strip() == "true" else "exited"
        absent = run_docker([
            "ps", "--all", "--quiet", "--no-trunc", "--filter", "id=" + proxy.container,
        ], 15)
        if absent.returncode == 0 and not absent.stdout.split():
            return "exited"
        raise WorldError("Docker could not verify credential proxy state")

    def get(self) -> Proxy:
        with self.lock:
            return self._get_locked()

    def recover(self, failed: Proxy, container: str) -> Proxy:
        with self.lock:
            if self.stopping.is_set():
                raise WorldError("credential proxy is stopping")
            if self.proxy is failed and failed.container != container:
                return failed
            if self.proxy is not failed:
                return self._get_locked()
            # A saturated loopback listener can transiently refuse a connect.
            # Do not turn that into a helper restart which drops every healthy
            # in-flight tunnel; only replace a helper Docker confirms exited.
            if self._state(failed) == "running":
                return failed
            return self._restart_locked(failed, container)

    def bootstrap(self) -> bytes:
        with self.lock:
            proxy = self._get_locked()
            if self._manifest is not None:
                return self._manifest
            self._manifest = bootstrap(self.policy, proxy.certificate, self.fake)
            return self._manifest

    def _get_locked(self) -> Proxy:
        if self.stopping.is_set():
            raise WorldError("credential proxy is stopping")
        if self.proxy is not None:
            # Keep Docker control-plane calls out of the per-tunnel path. A
            # failed loopback connect verifies state through recover().
            return self.proxy
        candidate = self._start()
        self.proxy = candidate
        return candidate

    def _restart_locked(self, proxy: Proxy, container: str) -> Proxy:
        now = time.monotonic()
        if now < self.recovery_not_before:
            raise WorldError("credential proxy recovery is cooling down")
        recovery_event(b"S")
        try:
            if not remove_container(container):
                raise WorldError("credential proxy cleanup could not be verified")
            replacement, port = self._launch(proxy.root, self.workspace_tag())
            if self.stopping.is_set():
                if not remove_container(replacement):
                    raise CleanupError("credential proxy cleanup could not be verified")
                raise WorldError("credential proxy is stopping")
            proxy.container = replacement
            proxy.port = port
        except Exception:
            recovery_event(b"F")
            raise
        finally:
            self.recovery_not_before = time.monotonic() + RECOVERY_COOLDOWN
        recovery_event(b"R")
        return proxy

    def _launch(self, root: Path, tag: str) -> tuple[str, int]:
        access, account = read_auth() if self.policy.name == "openai" else read_github_auth()
        private_replace(root / ("access-token" if self.policy.name == "openai" else "github-token"),
                        access.encode("utf-8"))
        if self.policy.name == "openai":
            private_replace(root / "account-id", account.encode("utf-8"))
        private_replace(
            root / "proxy.yaml",
            json.dumps(proxy_config(self.policy, self.fake[1], self.fake[0]),
                       separators=(",", ":")).encode("utf-8"),
        )

        name = "devc2-" + self.policy.name + "-proxy-" + uuid.uuid4().hex
        container_id = None
        try:
            launched = run_docker([
                "run", "--pull", "never", "--detach", "--rm", "--name", name,
                "--label", "dev.devbox." + self.policy.name + "-span.workspace-hash=" + tag,
                "--user", "%d:%d" % (os.getuid(), os.getgid()),
                "--read-only", "--tmpfs", "/tmp:size=16m,mode=1777",
                "--memory", "512m", "--cpus", "2", "--pids-limit", "512",
                "--cap-drop", "ALL", "--security-opt", "no-new-privileges:true",
                "--init", "--log-driver", "none",
                "--publish", "127.0.0.1::8080",
                "--volume", "%s:/run/devc2-private:ro" % root,
                IRON, "--config", "/run/devc2-private/proxy.yaml",
            ], 15, self.stopping)
            candidate_id = launched.stdout.strip()
            if launched.returncode != 0 or not re.fullmatch(r"[0-9a-f]{64}", candidate_id):
                raise WorldError("credential proxy failed to start")
            container_id = candidate_id
            if self.stopping.is_set():
                raise WorldError("credential proxy is stopping")

            deadline = time.monotonic() + 15
            port = 0
            while time.monotonic() < deadline and not self.stopping.is_set():
                result = run_docker(
                    ["port", container_id, "8080/tcp"], 15, self.stopping,
                )
                if result.returncode == 0:
                    match = re.fullmatch(r"127\.0\.0\.1:(\d+)", result.stdout.strip())
                    if match and 1 <= int(match.group(1)) <= 65535:
                        port = int(match.group(1))
                        try:
                            with socket.create_connection(("127.0.0.1", port), timeout=0.5):
                                break
                        except OSError:
                            port = 0
                time.sleep(0.05)
            if not port:
                if self.stopping.is_set():
                    raise WorldError("credential proxy is stopping")
                raise WorldError("credential proxy did not publish a loopback port")
            return container_id, port
        except Exception:
            removed = (remove_container(container_id) if container_id is not None
                       else remove_named_container(name))
            if not removed:
                raise CleanupError("credential proxy cleanup could not be verified")
            raise

    def _start(self) -> Proxy:
        tag = self.workspace_tag()
        self._remove_stale(tag)
        root = Path(tempfile.mkdtemp(prefix="devc2-" + self.policy.name + "-" + tag + "-"))
        os.chmod(str(root), 0o700)
        try:
            ca_name = "devc2-" + self.policy.name + "-ca-" + uuid.uuid4().hex
            try:
                generated = run_docker([
                    "run", "--pull", "never", "--name", ca_name, "--rm", "--network", "none",
                    "--label", "dev.devbox." + self.policy.name + "-span.workspace-hash=" + tag,
                    "--user", "%d:%d" % (os.getuid(), os.getgid()),
                    "--volume", "%s:/out" % root,
                    IRON, "generate-ca", "-outdir", "/out", "-alg", "ed25519",
                    "-name", "devc2 " + self.policy.name + " Span",
                ])
                if generated.returncode != 0:
                    raise WorldError("ephemeral CA generation failed")
            finally:
                if not remove_named_container(ca_name):
                    raise CleanupError("CA helper cleanup could not be verified")

            for filename in ("ca.crt", "ca.key"):
                path = root / filename
                metadata = path.lstat()
                if (not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode)
                        or metadata.st_size > MAX_CA):
                    raise WorldError("ephemeral CA output is invalid")
                os.chmod(str(path), 0o600)
            certificate = (root / "ca.crt").read_bytes()
            if (not certificate or len(certificate) > MAX_CA
                    or b"-----BEGIN CERTIFICATE-----" not in certificate
                    or b"-----END CERTIFICATE-----" not in certificate
                    or b"PRIVATE KEY" in certificate):
                raise WorldError("ephemeral CA certificate is invalid")

            container_id, port = self._launch(root, tag)
            return Proxy(root, container_id, port, certificate)
        except CleanupError:
            raise
        except Exception:
            remove_private_root(root)
            raise

    def stop(self) -> None:
        self.stopping.set()
        with self.lock:
            if self.proxy is not None:
                self.proxy.stop()
                self.proxy = None


def read_connect(connection: socket.socket, policy: Optional[Policy] = None) -> tuple[bytes, bytes]:
    policy = policy or DEFAULT_POLICY
    data = bytearray()
    marker = -1
    while marker < 0:
        if len(data) >= MAX_CONNECT:
            raise WorldError("CONNECT request is too large")
        chunk = connection.recv(min(4096, MAX_CONNECT - len(data)))
        if not chunk:
            raise WorldError("CONNECT request ended early")
        data.extend(chunk)
        marker = data.find(b"\r\n\r\n")
    end = marker + 4
    request = bytes(data[:end])
    lines = request[:-4].split(b"\r\n")
    match = CONNECT_LINE.fullmatch(lines[0]) if lines else None
    if match is None or match.group(1) not in policy.targets:
        raise WorldError("CONNECT target or version is not allowed")
    host_headers = 0
    for line in lines[1:]:
        if not line or line[:1] in (b" ", b"\t") or b":" not in line:
            raise WorldError("CONNECT contains an invalid header")
        name, value = line.split(b":", 1)
        if (HEADER_NAME.fullmatch(name) is None
                or any((byte < 32 and byte != 9) or byte == 127 for byte in value)):
            raise WorldError("CONNECT contains an invalid header")
        if name.lower() == b"host":
            host_headers += 1
            allowed_hosts = (match.group(1),)
            if policy.name == "openai":
                allowed_hosts += (b"chatgpt.com",)  # Undici omits the default port.
            if host_headers > 1 or value.strip(b" \t") not in allowed_hosts:
                raise WorldError("CONNECT Host does not match its target")
    return request, bytes(data[end:])


def pump(source: socket.socket, destination: socket.socket) -> None:
    try:
        while True:
            block = source.recv(64 * 1024)
            if not block:
                break
            destination.sendall(block)
    except OSError:
        pass
    finally:
        try:
            destination.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def relay(client: socket.socket, upstream: socket.socket) -> None:
    reverse = threading.Thread(target=pump, args=(upstream, client), daemon=True)
    reverse.start()
    pump(client, upstream)
    reverse.join()


def read_proxy_response(upstream: socket.socket) -> tuple[bytes, int]:
    data = bytearray()
    marker = -1
    while marker < 0:
        if len(data) >= MAX_CONNECT:
            raise WorldError("credential proxy response is too large")
        block = upstream.recv(min(4096, MAX_CONNECT - len(data)))
        if not block:
            raise WorldError("credential proxy response ended early")
        data.extend(block)
        marker = data.find(b"\r\n\r\n")
    first = bytes(data[:marker]).split(b"\r\n", 1)[0].split(b" ")
    if (len(first) < 2 or first[0] not in {b"HTTP/1.0", b"HTTP/1.1"}
            or not re.fullmatch(rb"[0-9]{3}", first[1])):
        raise WorldError("credential proxy returned an invalid response")
    return bytes(data), int(first[1])


def open_proxy_tunnel(manager: ProxyManager, request: bytes) -> tuple[socket.socket | None, bytes]:
    for attempt in range(2):
        proxy = manager.get()
        container = proxy.container
        try:
            upstream = socket.create_connection(("127.0.0.1", proxy.port), timeout=10)
        except OSError:
            if attempt:
                return None, b""
            manager.recover(proxy, container)
            time.sleep(0.25)
            continue
        try:
            upstream.sendall(request)
            response, status = read_proxy_response(upstream)
        except (OSError, WorldError):
            upstream.close()
            return None, b""
        if status == 200:
            return upstream, response
        upstream.close()
        return None, response
    return None, b""


def handle(connection: socket.socket, manager: ProxyManager) -> None:
    with connection:
        connection.settimeout(10)
        operation = connection.recv(1)
        if operation == b"B":
            payload = manager.bootstrap()
            connection.sendall(LENGTH.pack(len(payload)) + payload)
            return
        if operation != b"T":
            return
        try:
            request, trailing = read_connect(connection, manager.policy)
        except WorldError:
            connection.sendall(
                b"HTTP/1.1 400 Bad Request\r\n"
                b"Connection: close\r\nContent-Length: 0\r\n\r\n"
            )
            return
        upstream, response = open_proxy_tunnel(manager, request)
        if upstream is None:
            if response:
                connection.sendall(response)
            return
        with upstream:
            connection.sendall(response)
            if trailing:
                upstream.sendall(trailing)
            connection.settimeout(None)
            upstream.settimeout(None)
            relay(connection, upstream)


def wait_for_handler_slot(
    slots: threading.BoundedSemaphore,
    stopping: threading.Event,
) -> bool:
    while not stopping.is_set():
        if slots.acquire(timeout=0.5):
            return True
    return False


def serve(policy: Policy) -> int:
    try:
        descriptor = int(os.environ["DEVC2_SPAN_SOCKET_FD"])
    except (KeyError, ValueError):
        print(policy.name + "-world: missing Span listener", file=sys.stderr)
        return 2
    listener = socket.socket(fileno=descriptor)
    manager = ProxyManager(policy)
    slots = threading.BoundedSemaphore(MAX_HANDLERS)
    stopping = threading.Event()

    def stop(_signum: int, _frame: object) -> None:
        stopping.set()
        manager.stopping.set()
        try:
            listener.close()
        except OSError:
            pass

    for signum in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(signum, stop)
    try:
        while not stopping.is_set():
            try:
                connection, _address = listener.accept()
            except InterruptedError:
                continue
            except OSError:
                if stopping.is_set():
                    break
                raise
            if not wait_for_handler_slot(slots, stopping):
                connection.close()
                continue

            def run_handler(stream: socket.socket) -> None:
                try:
                    try:
                        handle(stream, manager)
                    except (OSError, WorldError, subprocess.SubprocessError):
                        pass
                finally:
                    slots.release()

            threading.Thread(target=run_handler, args=(connection,), daemon=True).start()
    finally:
        try:
            listener.close()
        except OSError:
            pass
        manager.stop()
    return 0


def main() -> int:
    policy = select_policy(sys.argv[0])
    if sys.argv[1:]:
        print(policy.name + "-world: World accepts no arguments", file=sys.stderr)
        return 2
    return serve(policy)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, WorldError, subprocess.SubprocessError):
        print(Path(sys.argv[0]).name + "-world: World failed", file=sys.stderr)
        raise SystemExit(1)
